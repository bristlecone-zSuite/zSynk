{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "synk-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
